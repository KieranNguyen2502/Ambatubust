# ============================================================================
# NUS Commute Planner - Environment Variables (.env.example)
# Copy this file to .env.local and fill in available credentials.
# All API keys are used strictly on the server side (/api/* route handlers).
# ============================================================================

# 1. LTA DataMall (Official - Singapore Land Transport Authority)
# Register at: https://datamall.lta.gov.sg/
# Used for: Real-time public bus arrivals (/v3/BusArrival) and load (SEA/SDA/LSD).
# Fallback if omitted: Uses OneMap scheduled durations + "Crowding information unavailable".
LTA_ACCOUNT_KEY=your_lta_datamall_account_key_here

# 2. SLA OneMap API (Official - Singapore Land Authority)
# Register at: https://www.onemap.gov.sg/apidocs/register
# Used for: Public transport routing (/api/public/routingsvc/route) and address search.
# The backend automatically exchanges email + password for a 3-day JWT token.
ONEMAP_EMAIL=your_registered_onemap_email@example.com
ONEMAP_PASSWORD=your_registered_onemap_password
# Optional: a pre-generated OneMap JWT. It expires after ~3 days; email + password above are preferred.
ONEMAP_STATIC_TOKEN=

# 3. NUSMods API v2 (Community-Operated Official Student Tool)
# Public & unauthenticated; override only if using a custom mirror.
NUSMODS_API_BASE_URL=https://api.nusmods.com/v2
NUSMODS_ACAD_YEAR=2026-2027

# 4. NUS Internal Shuttle Bus API (Unofficial / Reverse-Engineered Optional Proxy)
# Leave blank to use the built-in deterministic Static NUS ISB Schedule & Headway Registry.
# If configured, the backend will query live shuttle ETAs with a 2500ms timeout before falling back.
NUS_SHUTTLE_API_BASE_URL=
NUS_SHUTTLE_AUTH_HEADER=

# 5. Google Maps Routes API (Commercial Official - Optional Fallback)
# Planned: used only if OneMap Public Transport Routing fails or times out. (Not implemented yet.)
GOOGLE_MAPS_API_KEY=

# 6. Demo & Resilience Controls
# When true, allows falling back to recorded real-world route snapshots if all external routing APIs are unreachable.
ENABLE_DEMO_FALLBACK_SNAPSHOTS=true

